# Inbound mailbox for automatic Vehicle Health Monitor PDF imports.
# Use an IMAP app password or dedicated mailbox credential; do not commit real secrets.
VEHICLE_HEALTH_IMAP_HOST=imap.example.com
VEHICLE_HEALTH_IMAP_PORT=993
VEHICLE_HEALTH_IMAP_SECURE=true
VEHICLE_HEALTH_IMAP_USER=vehicle-health@example.com
VEHICLE_HEALTH_IMAP_PASS=
VEHICLE_HEALTH_IMAP_MAILBOX=INBOX
VEHICLE_HEALTH_IMAP_POLL_INTERVAL_MS=60000
VEHICLE_HEALTH_IMAP_LOOKBACK_DAYS=30
VEHICLE_HEALTH_IMAP_BATCH_SIZE=10
VEHICLE_HEALTH_IMAP_MAX_MESSAGE_BYTES=15728640

# At least one filter is required to avoid importing unrelated inbox PDFs.
VEHICLE_HEALTH_IMAP_FROM=reports@example.com
# VEHICLE_HEALTH_IMAP_SUBJECT=Vehicle Health
