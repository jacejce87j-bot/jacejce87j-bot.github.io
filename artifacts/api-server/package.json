    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "http-proxy-middleware": "^4.2.0",
    "imapflow": "^2.0.7",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.28",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.5",
